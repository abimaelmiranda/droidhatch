# Operating system and editor files
.DS_Store
.AppleDouble
.LSOverride
.idea/
.vscode/
.vs/
xcuserdata/
*.user
*.suo
*.swp

# Generated build output
artifacts/
bin/
obj/
publish/
.build/
DerivedData/
.swiftpm/
**/build/
**/.cxx/

# Native and CMake intermediates
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
*.o
*.d
*.pid
