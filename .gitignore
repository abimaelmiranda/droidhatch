# Android packages generated by local builds.
# The stable runtime prebuilts are intentionally versioned below.
*.apk
*.idsig
!image/prebuilt/*.apk
!image/prebuilt/*.idsig

# Images, archives and local packaging
*.img
*.zip
*.tar.gz
*.tar.xz
*.pkg

# Local runtime state and databases
.droidhatch/
*.sqlite
*.sqlite3
*.db

# Local secrets and credentials
.env
.env.*
!.env.example
*.pem
*.p12
*.key
*.netrc
