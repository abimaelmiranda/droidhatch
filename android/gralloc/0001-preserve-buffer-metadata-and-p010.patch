From droidhatch Mon Sep 17 00:00:00 2001
Subject: [PATCH] preserve buffer metadata and add P010 mapping

---
 gralloc/gralloc.cpp      | 36 ++++++++++++++++++++++++++++++++----
 gralloc/gralloc_priv.h  |  6 ++++--
 gralloc/mapper.cpp      | 27 +++++++++++++++++++++++++++
 3 files changed, 61 insertions(+), 8 deletions(-)

diff --git a/gralloc/gralloc.cpp b/gralloc/gralloc.cpp
--- a/gralloc/gralloc.cpp
+++ b/gralloc/gralloc.cpp
@@ -62,6 +62,11 @@ extern int gralloc_unlock(gralloc_module_t const* module,
         buffer_handle_t handle);
 
+extern int gralloc_lock_ycbcr(gralloc_module_t const* module,
+        buffer_handle_t handle, int usage,
+        int l, int t, int w, int h,
+        android_ycbcr* ycbcr);
+
 extern int gralloc_register_buffer(gralloc_module_t const* module,
         buffer_handle_t handle);
@@ -89,6 +94,7 @@ struct private_module_t HAL_MODULE_INFO_SYM = {
         .unregisterBuffer = gralloc_unregister_buffer,
         .lock = gralloc_lock,
         .unlock = gralloc_unlock,
+        .lock_ycbcr = gralloc_lock_ycbcr,
     },
     .framebuffer = 0,
@@ -144,6 +150,18 @@ static int gralloc_alloc(alloc_device_t* dev,
         return -EINVAL;
 
     int bytesPerPixel = 0;
+    bool isP010 = false;
     switch (format) {
+        case 43: // RGBA_1010102
+            bytesPerPixel = 4;
+            break;
+        case 56: // R8_UNORM
+            bytesPerPixel = 1;
+            break;
+        case 59: // R10G10B10A10_UNORM
+            bytesPerPixel = 8;
+            break;
+        case 54: // YCBCR_P010
+            isP010 = true;
+            bytesPerPixel = 2;
+            break;
         case HAL_PIXEL_FORMAT_RGBA_FP16:
             bytesPerPixel = 8;
             break;
@@ -169,14 +187,27 @@ static int gralloc_alloc(alloc_device_t* dev,
     const size_t tileHeight = 2;
 
     size_t stride = align(width, tileWidth);
-    size_t size = align(height, tileHeight) * stride * bytesPerPixel + 4;
+    size_t size = 0;
+    if (isP010) {
+        const size_t byteStride = stride * sizeof(uint16_t);
+        const size_t chromaHeight = (height + 1) / 2;
+        size = byteStride * height + byteStride * chromaHeight + 4;
+    } else {
+        size = align(height, tileHeight) * stride * bytesPerPixel + 4;
+    }
 
     int err = gralloc_alloc_buffer(dev, size, usage, pHandle);
@@ -185,7 +216,11 @@ static int gralloc_alloc(alloc_device_t* dev,
         return err;
     }
 
-    *pStride = stride;
+    *pStride = static_cast<int>(stride);
+    private_handle_t* hnd = const_cast<private_handle_t*>(
+            reinterpret_cast<const private_handle_t*>(*pHandle));
+    hnd->width = width;
+    hnd->height = height;
+    hnd->format = format;
+    hnd->stride = static_cast<int>(stride);
     return 0;
 }
diff --git a/gralloc/gralloc_priv.h b/gralloc/gralloc_priv.h
--- a/gralloc/gralloc_priv.h
+++ b/gralloc/gralloc_priv.h
@@ -77,6 +77,10 @@ struct private_handle_t {
     // FIXME: the attributes below should be out-of-line
     uint64_t base __attribute__((aligned(8)));
     int     pid;
+    int     width;
+    int     height;
+    int     format;
+    int     stride;
 
 #ifdef __cplusplus
@@ -87,7 +91,7 @@ struct private_handle_t {
     private_handle_t(int fd, int size, int flags) :
         fd(fd), magic(sMagic), flags(flags), size(size), offset(0),
-        base(0), pid(getpid())
+        base(0), pid(getpid()), width(0), height(0), format(0), stride(0)
     {
         version = sizeof(native_handle);
         numInts = sNumInts();
diff --git a/gralloc/mapper.cpp b/gralloc/mapper.cpp
--- a/gralloc/mapper.cpp
+++ b/gralloc/mapper.cpp
@@ -185,3 +185,30 @@ int gralloc_unlock(gralloc_module_t const* /*module*/,
         return -EINVAL;
     return 0;
 }
+
+int gralloc_lock_ycbcr(gralloc_module_t const* /*module*/,
+        buffer_handle_t handle, int /*usage*/,
+        int /*l*/, int /*t*/, int /*w*/, int /*h*/,
+        android_ycbcr* ycbcr)
+{
+    if (private_handle_t::validate(handle) < 0 || !ycbcr) {
+        return -EINVAL;
+    }
+
+    private_handle_t* hnd = (private_handle_t*)handle;
+    if (hnd->format != 54) {
+        return -EINVAL;
+    }
+
+    const size_t byteStride = static_cast<size_t>(hnd->stride) * sizeof(uint16_t);
+    const size_t chromaOffset = byteStride * static_cast<size_t>(hnd->height);
+    uint8_t* base = reinterpret_cast<uint8_t*>(hnd->base);
+
+    ycbcr->y = base;
+    ycbcr->cb = base + chromaOffset;
+    ycbcr->cr = base + chromaOffset + sizeof(uint16_t);
+    ycbcr->ystride = byteStride;
+    ycbcr->cstride = byteStride;
+    ycbcr->chroma_step = sizeof(uint16_t) * 2;
+    return 0;
+}
